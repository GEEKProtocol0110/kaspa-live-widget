<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 Kaspa Widget: Quick Glance View -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kaspa_blob_background">

    <!-- Centered mirrored Kaspa mark -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/kaspa_mark"
        android:contentDescription="@null"
        android:alpha="0.15"
        android:layout_gravity="center" />

    <!-- Data Overlay Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Time - Top -->
        <TextView
            android:id="@+id/widget_time"
            style="@style/Widget.Kaspa.Text.Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:gravity="start"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/widget_updated"
            style="@style/Widget.Kaspa.Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for data"
            android:layout_marginBottom="4dp" />

        <!-- Spacer to push price to center -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- KAS Price - Center Focus -->
        <LinearLayout
            style="@style/Widget.Kaspa.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/widget_price"
                style="@style/Widget.Kaspa.Text.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$--" />

        </LinearLayout>

        <!-- Block Height - Bottom -->
        <LinearLayout
            style="@style/Widget.Kaspa.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                style="@style/Widget.Kaspa.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/block_label"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_block_height"
                style="@style/Widget.Kaspa.Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
