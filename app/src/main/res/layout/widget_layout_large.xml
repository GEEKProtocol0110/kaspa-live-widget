<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4 Kaspa Widget: Expanded Command View -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kaspa_blob_background">

    <!-- Centered mirrored Kaspa mark, larger than the 2x2 version -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/kaspa_mark"
        android:contentDescription="@null"
        android:alpha="0.12"
        android:layout_gravity="center" />

    <!-- Data Overlay Container - More Breathing Room -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Time + Last Updated -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/widget_time"
                style="@style/Widget.Kaspa.Text.Time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--:--"
                android:gravity="start" />

            <TextView
                android:id="@+id/widget_updated"
                style="@style/Widget.Kaspa.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Updated: --"
                android:gravity="end" />
        </LinearLayout>

        <!-- Spacer -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- KAS Price Panel - Expanded -->
        <LinearLayout
            style="@style/Widget.Kaspa.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/widget_price"
                style="@style/Widget.Kaspa.Text.Price.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$--" />

            <TextView
                android:id="@+id/widget_price_change"
                style="@style/Widget.Kaspa.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24h: --"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Network Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Block Height -->
            <LinearLayout
                style="@style/Widget.Kaspa.Panel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginEnd="8dp">

                <TextView
                    style="@style/Widget.Kaspa.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/block_label" />

                <TextView
                    android:id="@+id/widget_block_height"
                    style="@style/Widget.Kaspa.Text.Value.Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- BPS -->
            <LinearLayout
                style="@style/Widget.Kaspa.Panel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp">

                <TextView
                    style="@style/Widget.Kaspa.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bps_label" />

                <TextView
                    android:id="@+id/widget_bps"
                    style="@style/Widget.Kaspa.Text.Value.Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Hashrate - Bottom Zone -->
        <LinearLayout
            style="@style/Widget.Kaspa.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                style="@style/Widget.Kaspa.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hashrate_label" />

            <TextView
                android:id="@+id/widget_hashrate"
                style="@style/Widget.Kaspa.Text.Value.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="N/A"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
